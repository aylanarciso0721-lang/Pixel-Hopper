function bg(){const g=X.createLinearGradient(0,0,0,150);L.sk.forEach((k,i)=>g.addColorStop(i/3,k));X.fillStyle=g;X.fillRect(0,0,W,H);
 const nt=!!L.st_,sx=250-(camX*.02%30),rg=X.createRadialGradient(sx,38,2,sx,38,nt?34:60);rg.addColorStop(0,nt?'rgba(215,228,255,.95)':'rgba(255,250,210,.95)');rg.addColorStop(.25,nt?'rgba(170,190,255,.4)':'rgba(255,240,170,.45)');rg.addColorStop(1,'rgba(255,255,255,0)');X.fillStyle=rg;X.fillRect(sx-70,0,140,110);X.fillStyle='#fff';
 if(L.st_){for(let i=0;i<40;i++)if((fr/15+i)%5>1)X.fillRect((i*83)%W,(i*47)%110,1,1)}
 else for(let i=0;i<5;i++){const a=((i*110-camX*.3)%550+550)%550-60,b=14+i*9%40;X.fillRect(a|0,b,28,6);X.fillRect(a+5|0,b-4,16,4)}
 X.globalAlpha=.5;hills(132,26,L.h1,.1);X.globalAlpha=1;hills(150,30,L.h1,.2);hills(170,22,L.h2,.45);for(let i=0;i<24;i++){X.fillStyle=L.st_?'rgba(255,255,150,'+(.3+.3*Math.sin(fr/20+i)).toFixed(2)+')':'rgba(255,255,255,.35)';X.fillRect(((i*53+fr*(.2+i%3*.15))%W)|0,(i*37%150+Math.sin(fr/40+i)*8)|0,i%2+1,i%2+1)}}
