 R(2,6,28,24,q);R(6,2,20,6,q);R(0,12,4,12,q);R(28,12,4,12,q);R(5,30,8,2,'#000');R(19,30,8,2,'#000');R(6,0,3,5,'#eee');R(23,0,3,5,'#eee');R(8,10,6,6,'#fff');R(18,10,6,6,'#fff');R(10+d*2,12,3,4,'#f00');R(20+d*2,12,3,4,'#f00');R(9,22,14,4,'#200');for(let i=0;i<4;i++)R(10+i*3,22,2,2,'#fff');
 R(2,6,5,24,'rgba(255,255,255,.18)');R(2,26,28,4,'rgba(0,0,0,.3)');R(25,6,5,24,'rgba(0,0,0,.2)')}
