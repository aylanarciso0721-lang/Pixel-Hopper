/* ===== RENDERING ===== */
function tx(s,x,y,c,sz,al){sz=sz||8;X.font=sz+'px "Press Start 2P",monospace';X.textAlign=al||'left';X.textBaseline='top';const o=sz>>3;X.fillStyle='#000';X.fillText(s,x+o,y+o);X.fillStyle=c||'#fff';X.fillText(s,x,y)}
const vo=n=>{const v=Math.min(n,ML[scene][2]),o=Math.max(0,Math.min(sel-(v>>1),n-v));return[v,o]};
