 if(k==0){R(1,4,14,9,'#c04080');R(3,2,10,2,'#c04080');R(2+f*2,13,5,3,'#702050');R(9-f*2,13,5,3,'#702050');E(3);E(9)}
 else if(k==1){const s=e.g?2:0;R(2,3+s,12,11-s,'#40c050');R(4,1+s,8,2,'#40c050');R(3,14,4,2,'#206830');R(9,14,4,2,'#206830');E(3);E(9)}
 else if(k==2){R(5,5,6,6,'#8040c0');R(0,3+f*3,5,4,'#a060e0');R(11,3+f*3,5,4,'#a060e0');R(5,3,2,2,'#8040c0');R(9,3,2,2,'#8040c0');R(6,7,1,1,'#f00');R(9,7,1,1,'#f00')}
 else if(k==3){R(1,6,14,8,'#e07020');for(let i=0;i<4;i++){R(2+i*4,2,2,4,'#ffd0a0');R(3+i*4,0,1,2,'#ffd0a0')}R(2+f*2,14,5,2,'#803010');R(9-f*2,14,5,2,'#803010');R(3+d*6,8,3,3,'#fff');R(4+d*6,9,1,2,'#000')}
 else{X.globalAlpha=.8;R(2,1,12,13,'#f0f0ff');for(let i=0;i<3;i++)R(2+i*4,14,4,1+((f^i)&1)*2,'#f0f0ff');X.globalAlpha=1;R(4,5,3,4,'#202040');R(9,5,3,4,'#202040');R(6,11,4,2,'#202040')}R(2,3,5,1,'rgba(255,255,255,.35)');R(1,12,14,2,'rgba(0,0,0,.2)');if(S.ol||S.cb){X.strokeStyle='rgba(255,255,255,.85)';X.strokeRect(a+.5,b+.5,15,15)}}
const hr=(x,y)=>{X.fillStyle='#ff3050';[[1,0,2],[4,0,2],[0,1,7],[0,2,7],[1,3,5],[2,4,3],[3,5,1]].forEach(([a,b,w])=>X.fillRect(x+a,y+b,w,1))};
function world(){const cm=camX|0;bg();
 for(let ty=0;ty<12;ty++)for(let a=Math.max(0,cm>>4);a<=Math.min(L.w-1,(cm+W)>>4);a++){const t=G[ty][a];if(t==1)tl(a*16-cm,ty*16,a*7+ty*13,!(G[ty-1]&&G[ty-1][a]==1));else if(t==2)spk(a*16-cm,ty*16)}
 co.forEach(k=>{if(k.t)return;const w=Math.abs(Math.cos(fr/12+k.x))*6+2|0,a=k.x-cm-w/2|0;X.fillStyle='rgba(255,216,0,.18)';X.fillRect(a-2,k.y-7,w+4,14);X.fillStyle='#e0a000';X.fillRect(a,k.y-5,w,10);X.fillStyle='#ffd800';X.fillRect(a,k.y-5,Math.max(1,w-1),9);X.fillStyle='#fff8a0';X.fillRect(a,k.y-5,1,9)});
 pu.forEach(o=>{if(o.t)return;const q=PN[o.k],a=o.x-cm|0,b=o.y+Math.sin(fr/15+o.x)*3|0;X.fillStyle=q[2];X.globalAlpha=.25+.1*Math.sin(fr/8);X.fillRect(a-10,b-10,20,20);X.globalAlpha=1;X.fillRect(a-5,b-5,10,10);X.fillStyle='#fff';X.fillRect(a-5,b-5,10,1);tx(q[0],a-4,b-4,'#fff')});
 en.forEach(e=>e.a&&sh(e.x+7,e.y+e.h,8));if(!dead)sh(p.x+6,p.y+p.h,8);
 en.forEach(e=>e.a&&enemy(e,cm));if(bo&&bo.a){sh(bo.x+14,bo.y+bo.h,16);boss(cm)}
 if(!fl.off){const fa=fl.x-cm;X.fillStyle='#ddd';X.fillRect(fa+3,fl.y,2,32);X.fillStyle='#ff4040';X.fillRect(fa+5,fl.y+2,9-(fr>>4&1)*2,7);X.fillStyle='#ffd800';X.fillRect(fa+1,fl.y-2,6,3);}
 if(p.pw[0]>0){X.fillStyle='rgba(64,224,255,.22)';X.fillRect(p.x-cm-3|0,p.y-3|0,p.w+6,p.h+6)}
 if(p.pw[3]>0){X.fillStyle='hsla('+(fr*14%360)+',100%,60%,.35)';X.fillRect(p.x-cm-2|0,p.y-2|0,p.w+4,p.h+4)}
 if(p.pw[1]){X.strokeStyle='rgba(255,216,0,.85)';X.beginPath();X.arc(p.x+6-cm,p.y+7,12,0,7);X.stroke()}
 if(!(p.inv>0&&fr>>2&1))drawP(p.x-2-cm|0,p.y-1|0,p.f,p.g&&Math.abs(p.vx)>.3);
 fb.forEach(q=>{X.fillStyle='rgba(255,120,30,.35)';X.fillRect(q.x-cm-5|0,q.y-5|0,10,10);X.fillStyle='#ffd040';X.fillRect(q.x-cm-2|0,q.y-2|0,5,5);X.fillStyle='#fff';X.fillRect(q.x-cm-1|0,q.y-1|0,2,2)});
 bs.forEach(q=>{X.fillStyle='rgba(255,40,40,.35)';X.fillRect(q.x-cm-6|0,q.y-6|0,12,12);X.fillStyle='#ff3030';X.fillRect(q.x-cm-3|0,q.y-3|0,6,6);X.fillStyle='#fff';X.fillRect(q.x-cm-1|0,q.y-1|0,2,2)});
 pts.forEach(q=>{X.fillStyle=q.c;X.fillRect(q.x-cm|0,q.y|0,2,2)});
 X.fillStyle='rgba(0,0,0,.55)';X.fillRect(0,0,W,12);tx((L.tut?'':'L'+(Lv+1)+' ')+L.n,4,2);X.fillStyle='#ffd800';X.fillRect(152,3,5,7);tx(coins+'/'+tot,160,2,'#ffd800');tx('SC '+String(coins*10+stomps*50).padStart(4,'0'),204,2,'#fff');for(let i=0;i<lives;i++)hr(W-10-i*9,3);
 for(let i=0;i<4;i++)if(p.pw[i]>0){const x=4+i*26;X.fillStyle='rgba(0,0,0,.6)';X.fillRect(x,14,24,11);X.fillStyle=PN[i][2];X.fillRect(x+1,23,Math.max(1,22*Math.min(1,p.pw[i]/PD[i])|0),1);tx(PN[i][0],x+8,14,PN[i][2])}
 if(bo&&bo.a&&L.lk){const B=BS[bo.k];X.fillStyle='rgba(0,0,0,.65)';X.fillRect(60,H-30,200,22);X.fillStyle='#400';X.fillRect(62,H-18,196,4);X.fillStyle=B[1];X.fillRect(62,H-18,196*bo.hp/bo.mx|0,4);tx(B[0],W/2,H-28,'#fff',8,'center')}
 const z=(L.tx||[]).find(t=>p.x/16>=t[0]&&p.x/16<=t[1]);if(z){X.fillStyle='rgba(0,0,0,.7)';X.fillRect(16,30,W-32,28);X.fillStyle='#ffd800';X.fillRect(16,30,2,28);tx(z[2],W/2,34,'#fff',8,'center');tx(z[3],W/2,46,'#ffd800',8,'center')}
 if(S.dev){if(S.box){X.strokeStyle='#0f0';X.strokeRect(p.x-cm+.5,p.y+.5,p.w-1,p.h-1);X.strokeStyle='#f0f';en.forEach(e=>e.a&&X.strokeRect(e.x-cm+.5,e.y+.5,e.w-1,e.h-1));X.strokeStyle='#ff0';X.strokeRect(fl.x-cm+.5,fl.y+.5,7,31)}
  const r=['VER '+VER,'FPS '+fps+' '+TSV[S.ts]+'X','X '+(p.x|0)+' Y '+(p.y|0),'VX '+p.vx.toFixed(1)+' VY '+p.vy.toFixed(1),'GND '+p.g+' LIVES '+lives,(S.god?'GOD ':'')+(S.fly?'FLY ':'')+(S.box?'BOX':'')];
  X.fillStyle='rgba(0,0,0,.7)';X.fillRect(W-132,14,130,r.length*10+4);r.forEach((s,i)=>tx(s,W-128,17+i*10,'#0f0'));
  tx('G GOD H BOX F FLY N/B LVL [ ] SPD',4,H-10,'#0f0');tx('1-4 POWERS K BOSS L LOG R RESTART',4,H-20,'#0f0');if(dbl)DBG.slice(-9).forEach((s,i)=>tx(s.slice(0,38),4,28+i*9,'#0f0'))}}
function draw(){X.imageSmoothingEnabled=false;X.save();
 if(shake>0){if(S.shk)X.translate(Math.random()*4-2|0,Math.random()*4-2|0)}
 const gm=['play','pause','over','clear'].includes(scene);
 if(gm)world();else{camX=fr*.5;bg();for(let i=-1;i<22;i++)tl(i*16-((camX|0)%16),176,i+(camX>>4),1);drawP(hero.x|0,hero.y|0,1,1)}
 if(scene=='title'){[...'PIXEL HOPPER'].forEach((ch,i)=>tx(ch,W/2-96+i*16,24+Math.round(Math.sin(fr/14+i*.6)*3),['#ff5050','#ffd800','#40e0ff','#80ff60'][i%4],16));tx('A RETRO PLATFORMER',W/2,52,'#fff',8,'center');menu();tx('ARROWS+ENTER / MOUSE / TOUCH',W/2,180,'#fff',8,'center');if(S.dev)tx('DEV',4,4,'#40e0ff');tx('V'+VER,W-4,4,'#fff',8,'right')}
 else if(scene!='play'){X.fillStyle='rgba(0,0,0,.72)';X.fillRect(0,0,W,H);const h=HD[scene];tx(h[0],W/2,h[1],h[2],h[3],'center');
  if(scene=='about')[['PIXEL HOPPER','#ffd800'],['VERSION '+VER,'#40e0ff'],['1.02 DEEP BUGFIX UPDATE','#80ff60'],['- DEMON JUMP + LEVEL LAYOUT FIXES','#fff'],['- ERROR RECOVERY + SAFER SAVES','#fff'],['1.01 BUGFIX UPDATE','#80ff60'],['- PAUSE, MENU + CODE SCREEN FIXES','#fff'],['1.0 MAJOR UPDATE','#80ff60'],['- 15 LEVELS + 3 BOSSES','#fff'],['- SUPERPOWERS + LEVITATION','#fff'],['- DEV CODE LOCK + ACCESSIBILITY','#fff'],['0.1-0.9 BETA BUILDS','#80ff60']].forEach((l,i)=>tx(l[0],W/2,18+i*10,l[1],8,'center'));
  if(scene=='clear'){tx('COINS '+coins+'/'+tot+'  STOMPS '+stomps,W/2,56,'#fff',8,'center');tx('TIME '+(tm|0)+'S  SCORE '+fin,W/2,68,'#ffd800',8,'center');tx('BEST '+(P.b[Lv]||0),W/2,80,'#40e0ff',8,'center');if(Lv==LV.length-2)tx('ALL LEVELS CLEARED!',W/2,92,'#80ff60',8,'center')}
  if(scene=='su'){const d=DF[S.df],h=HERO[S.hr];tx('LIVES '+d[1]+'  ENEMY SPEED '+d[2]+'X',W/2,100,'#aaa',8,'center');tx(h[0]+': '+h[6],W/2,114,'#ffd800',8,'center');drawP(W/2-8,128,1,1)}
  if(scene=='code')codeUI();else menu()}
 X.restore();if(S.vg){X.fillStyle=VG;X.fillRect(0,0,W,H)}if(toast>0){X.fillStyle='rgba(0,0,0,.85)';X.fillRect(30,84,260,24);tx(tt,W/2,92,tcl,8,'center')}}
/* ===== INPUT ===== */
function ptr(e,down){const r=c.getBoundingClientRect(),mx=(e.clientX-r.left)*W/r.width,my=(e.clientY-r.top)*H/r.height;
 if(scene=='play')return;if(down)au();
 if(scene=='code'){if(down){const q=Math.floor((mx-100)/40),w=Math.floor((my-60)/24);if(q>=0&&q<3&&w>=0&&w<4)kp(['1','2','3','4','5','6','7','8','9','<','0','OK'][w*3+q]);else if(my<16)go('settings')}return}
 const it=M[scene](),[y0,lh]=ML[scene],o=vo(it.length)[1],j=Math.floor((my-y0+(lh-8)/2)/lh),i=j+o;
 if(j>=0&&i<it.length&&Math.abs(mx-W/2)<130){if(sel!=i){sel=i;rst=0;SF.sel()}if(down)it[i][1]()}
 else if(down&&scene=='title')hop()}
c.addEventListener('pointermove',e=>ptr(e,0));c.addEventListener('pointerdown',e=>ptr(e,1));
const nv=()=>{SF.sel();rst=0;if(scene=='title')hop()};
addEventListener('keydown',e=>{const k=e.key.length>1?e.key:e.key.toLowerCase();au();
 if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(k))e.preventDefault();
 if(k=='`'){if(S.du){S.dev^=1;sv();SF.ok()}else if(scene!='play'&&scene!='code'){cd='';back=scene=='pause'?'pause':'title';go('code')}return}
 if(scene=='code'){if(k=='Backspace')e.preventDefault();if(/^[0-9]$/.test(k))kp(k);else if(k=='Backspace')kp('<');else if(k=='Enter')kp('OK');else if(k=='Escape')go('settings');return}
 if(scene=='play'){
  if(k=='Escape'||k=='p')pause();
  if(!e.repeat&&(k=='ArrowUp'||k=='w'||k==' '||k=='z'))jb=6;
  if(!e.repeat&&(k=='x'||k=='Shift'))fq=1;
  if(DV()){if(k=='1'||k=='2'||k=='3'||k=='4')p.pw[+k-1]=PD[+k-1];if(k=='k'&&bo&&bo.a)bhit(bo.hp);if(k=='l')dbl^=1;if(k=='g')S.god^=1;if(k=='h')S.box^=1;if(k=='f')S.fly^=1;if(k=='n'&&Lv<LV.length-2)ld(Lv+1);if(k=='b'&&Lv>0)ld(Lv-1);if(k=='r')ld(Lv);if(k=='[')S.ts=Math.max(0,S.ts-1);if(k==']')S.ts=Math.min(3,S.ts+1)}
  K[k]=1}
 else{if(scene=='pause'&&k=='p'){scene='play';return}const it=M[scene](),n=it.length;
  if(k=='ArrowUp'||k=='w'){sel=(sel+n-1)%n;nv()}
  else if(k=='ArrowDown'||k=='s'){sel=(sel+1)%n;nv()}
  else if((k=='ArrowLeft'||k=='a'||k=='ArrowRight'||k=='d')&&it[sel][2]){it[sel][1]()}
  else if((k=='Enter'||k==' '||k=='z')&&!e.repeat)it[sel][1]();
  else if(k=='Escape'){if(scene=='pause')scene='play';else if(scene=='settings')go(back);else if(scene!='title')go(PAR[scene]||'title')}}});
addEventListener('keyup',e=>{K[e.key.length>1?e.key:e.key.toLowerCase()]=0});
addEventListener('blur',()=>{K={};pause()});document.addEventListener('visibilitychange',()=>{if(document.hidden){K={};pause()}});
document.querySelectorAll('#tp button').forEach(b=>{const k=b.dataset.k;
 b.addEventListener('pointerdown',e=>{e.preventDefault();au();if(k=='pause')return scene=='pause'?(scene='play'):pause();K[k]=1;if(k=='x'&&scene=='play')fq=1;if(S.vb&&navigator.vibrate)navigator.vibrate(10);if(k=='z'&&scene=='play')jb=6});
 ['pointerup','pointerleave','pointercancel'].forEach(t=>b.addEventListener(t,()=>{K[k]=0}))});
/* ===== MAIN LOOP ===== */
let last=performance.now(),acc=0;
function loop(t){requestAnimationFrame(loop);try{const dt=Math.max(0,Math.min((t-last)/1000,.1));last=t;fc++;ft+=dt;if(ft>=.5){fps=Math.round(fc/ft);fc=ft=0}
 acc+=dt*60*(S.dev&&scene=='play'?TSV[S.ts]:1);let n=0;while(acc>=1&&n++<8){step();if(S.dev&&scene=='play'&&fr%60==0){const v=inv();if(v.length)dbg('INV',v[0])}acc--}if(acc>=1)acc=0;
 wr.classList.toggle('crt',!!S.crt);draw();ERR.n=0}catch(e){acc=0;fail(e)}}
/* ===== DEBUG API (read-only inspection for the console and tests/run-tests.js) ===== */
window.PH={get version(){return VER},get scene(){return scene},get p(){return p},get L(){return L},get G(){return G},get en(){return en},get bo(){return bo},get pu(){return pu},get S(){return S},get P(){return P},get K(){return K},get lives(){return lives},get dead(){return dead},get back(){return back},
 LV,DF,HERO,PD,M,ML,HD,PAR,step,draw,play,go,ld,kp,inv,log:()=>DBG.slice(),errors:()=>ERR,state:()=>({scene,Lv,fr,lives,dead,p:p&&{x:p.x|0,y:p.y|0,vx:+p.vx.toFixed(2),vy:+p.vy.toFixed(2),pw:p.pw},boss:bo&&{hp:bo.hp,a:bo.a}}),
 set:(k,v)=>({jb:()=>jb=v,fq:()=>fq=v,cd:()=>cd=v,scene:()=>scene=v,back:()=>back=v,lives:()=>lives=v})[k]()};
applyS();requestAnimationFrame(loop);
</script></body></html>
